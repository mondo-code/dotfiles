// -*- mode: jsonc -*-
{
	"layer": "top",
	"position": "bottom",
	"height": 16,
	"spacing": 0,
	"margin": "0px 4px 4px 4px",

	"modules-left": [
		"river/tags",
		"river/layout"
	],

	"modules-center": [
		"clock"
	],

	"modules-right": [
		"custom/swayidle",
		"custom/separator",
		"disk",
		"custom/separator",
		"memory"
	],

	"custom/separator": {
		"format": "|"
	},

	"custom/swayidle": {
		"format": "<span foreground='#e69875'> λ</span> {text} ",
		"exec": "pgrep -x swayidle >/dev/null && echo 'on' || echo 'off'",
		"interval": 5
	},

	"river/tags": {
		"tag-labels": [
			"I",
			"II",
			"III",
			"IV",
			"V",
			"VI",
			"VII",
			"VIII",
			"IX"
		],
		"hide-vacant": true
	},

	"river/layout": {
		"format": " {} "
	},

	"disk": {
		"path": "/home",
		"format": "<span foreground='#e69875'> σ</span> {free} ",
	},

	"memory": {
		"format": "<span foreground='#e69875'> μ</span> {used:0.1f}G "
	},

    "clock": {
        "format": "<span foreground='#e69875'> τ</span> {:%I:%M %p} ",
		"tooltip-format": "{:%A, %B %d, %Y}"
    }
}
