#! /bin/sh

pgrep -x sxhkd > /dev/null || sxhkd &

xrandr --output DP-4 --mode 2560x1440 --rate 239.88 --primary --output DP-0 --mode 1920x1080 --rate 144.00 --pos 2560x0 --right-of DP-4
xset m 1 0 
xset r rate 300 50
xinput --set-prop 9 297 -0.7

for MONITOR in $(bspc query -M); do
	bspc monitor ${MONITOR} --reset-desktops \
		1 2 3 4 5 6 7 8 9
done

bspc config -m focused monitor:focused
bspc config -m focused desktop:focused

bspc config border_width         2
bspc config window_gap			 4
bspc config bottom_padding       0
bspc config left_padding         0
bspc config right_padding        0

bspc config split_ratio          0.5
bspc config borderless_monocle   true
bspc config gapless_monocle      true

bspc config focus_follows_pointer     true
bspc config pointer_follows_focus     true 
bspc config pointer_follows_monitor   true
bspc config pointer_motion_interval   7
bspc config pointer_modifier          mod4
bspc config pointer_action1           move
bspc config pointer_action2           resize_side
bspc config pointer_action3           resize_corner

bspc config normal_border_color '#3b4252'
bspc config active_border_color '#4c566a'
bspc config focused_border_color '#81a1c1'
bspc config presel_feedback_color '#8fbcbb'

bspc rule -a Gimp desktop='^8' state=floating follow=on
bspc rule -a mplayer2 state=floating
bspc rule -a Kupfer.py focus=on
bspc rule -a Screenkey manage=off

if type "xrandr"; then
  for m in $(xrandr --query | grep " connected" | cut -d" " -f1); do
    MONITOR=$m polybar -r -c ~/.config/polybar/config.ini &
  done
else
  polybar -r -c ~/.config/polybar/config.ini &
fi

xinput --set-prop 8 288 -0.4
exec $HOME/.config/bspwm/autostart

dbus-launch pipewire
